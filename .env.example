# ==============================================================================
# ColdMail Automation - Environment Configuration
# ==============================================================================
# Copy this file to '.env' and fill in your actual credentials.
# NEVER commit your '.env' file to source control.

# Sender Details
SMTP_EMAIL="your_email@gmail.com"
SMTP_NAME="Swaraj Gupta"
SMTP_REPLY_TO="your_email@gmail.com"

# SMTP Server Settings (Default: Google Gmail)
SMTP_SERVER="smtp.gmail.com"
SMTP_PORT=587
SMTP_USE_TLS=true

# Authentication: For Gmail, generate a 16-character App Password:
# 1. Enable 2-Step Verification in your Google Account: https://myaccount.google.com/security
# 2. Go to "App passwords": https://myaccount.google.com/apppasswords
# 3. Create a password for "Mail" / "ColdMail" and paste the 16 characters below
SMTP_PASSWORD="xxxx xxxx xxxx xxxx"

# Anti-Spam & Deliverability Defaults
MIN_DELAY_SECONDS=8
MAX_DELAY_SECONDS=18
MAX_EMAILS_PER_DOMAIN=5
DRY_RUN=false
